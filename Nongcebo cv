    <style>
        /* Mobile-First CV Design */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        }
        
        body {
            background: #f0f4f8;
            color: #333;
            line-height: 1.5;
            padding: 15px;
            max-width: 100%;
        }
        
        .cv {
            background: white;
            border-radius: 10px;
            box-shadow: 0 3px 15px rgba(0,102,204,0.1);
            padding: 20px;
            margin: 0 auto;
        }
        
        /* Header */
        .header {
            text-align: center;
            padding-bottom: 20px;
            border-bottom: 2px solid #0066cc;
            margin-bottom: 20px;
        }
        
        .name {
            color: #0066cc;
            font-size: 1.8rem;
            font-weight: bold;
            margin-bottom: 5px;
        }
        
        .title {
            color: #555;
            font-size: 1rem;
            margin-bottom: 15px;
        }
        
        .contact {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            font-size: 0.9rem;
        }
        
        .contact span {
            background: #e6f2ff;
            padding: 5px 10px;
            border-radius: 15px;
            color: #0066cc;
        }
        
        /* Sections */
        .section {
            margin-bottom: 25px;
        }
        
        .section-title {
            color: #0066cc;
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 10px;
            padding-bottom: 5px;
            border-bottom: 1px solid #e0e0e0;
        }
        
        /* Items */
        .item {
            margin-bottom: 15px;
            padding: 10px;
            border-left: 3px solid #0066cc;
            background: #f9f9f9;
            border-radius: 0 8px 8px 0;
        }
        
        .item-title {
            font-weight: 600;
            color: #2c3e50;
        }
        
        .item-subtitle {
            color: #0066cc;
            font-size: 0.9rem;
        }
        
        .item-date {
            color: #666;
            font-size: 0.85rem;
            margin-top: 3px;
        }
        
        .item-desc {
            margin-top: 8px;
            font-size: 0.9rem;
            color: #444;
        }
        
        .item-desc li {
            margin-left: 20px;
            margin-bottom: 3px;
        }
        
        /* Skills */
        .skills {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
        }
        
        .skill {
            background: #0066cc;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
        }
        
        /* References */
        .ref {
            background: #f0f8ff;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 10px;
            border-left: 3px solid #0066cc;
        }
        
        .ref-name {
            font-weight: 600;
            color: #0066cc;
        }
        
        .ref-title {
            font-size: 0.9rem;
            color: #555;
        }
        
        .ref-email {
            font-size: 0.85rem;
            color: #666;
            word-break: break-all;
        }
        
        /* Print Button */
        .print-btn {
            display: block;
            width: 100%;
            background: #0066cc;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            margin: 20px 0;
            cursor: pointer;
            text-align: center;
            text-decoration: none;
        }
        
        @media print {
            body {
                background: white;
                padding: 0;
            }
            
            .print-btn {
                display: none;
            }
            
            .cv {
                box-shadow: none;
            }
        }
    </style>
</head>
